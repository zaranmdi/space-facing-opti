# Choose one auth approach for non-interactive hosting.
# SNOWFLAKE_PASSWORD=your_password
# SNOWFLAKE_AUTHENTICATOR=username_password_mfa

# Or use a named connection that already exists on the host.
# SNOWFLAKE_CONNECTION_NAME=default

# Or use OAuth token-based auth.
# SNOWFLAKE_TOKEN=your_access_token
# SNOWFLAKE_AUTHENTICATOR=oauth